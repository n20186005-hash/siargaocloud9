---
import { languages, defaultLang, type LangCode } from '../i18n/config';
import { strings } from '../i18n/ui';
import '../styles/global.css';

export interface Props {
  lang: LangCode;
}

const { lang } = Astro.props;
const t = strings[lang];
const langConfig = languages[lang];

const prefix = lang === defaultLang ? '' : `/${lang}`;
const otherLang = lang === 'en' ? 'fil' : 'en';
const otherPrefix = otherLang === defaultLang ? '/' : `/${otherLang}/`;

const pathname = Astro.url.pathname.replace(/^\/(en|fil)\/?/, '').replace(/^\/$/, '') || '';
const alternatePath = `${otherPrefix}${pathname}${pathname.endsWith('/') ? '' : ''}`.replace(/\/+$/, '/') || (otherPrefix === '/' ? '/' : otherPrefix);

const canonicalUrl = Astro.site ? new URL(prefix ? `${prefix}/` : '/', Astro.site).toString() : undefined;
const ogImage = Astro.site ? new URL('/images/cloud9-hero.jpg', Astro.site).toString() : '/images/cloud9-hero.jpg';
const schemaImage = Astro.site ? new URL('/images/cloud9-hero.jpg', Astro.site).toString() : undefined;

const itineraryItems = t.tripList.items.map((item, idx) => ({
  id: `item-${idx}`,
  name: item.name,
  meta: item.meta,
}));

const attractionLd = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LocalBusiness'],
  name: t.schema.attractionName,
  description: t.schema.attractionDesc,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'R578+F36 Siargao Island',
    addressLocality: 'General Luna',
    addressRegion: 'Surigao del Norte',
    addressCountry: 'PH',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 9.8136625,
    longitude: 126.1651406,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '00:00',
      closes: '23:59',
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.5',
    reviewCount: '3347',
    bestRating: '5',
    worstRating: '1',
  },
  ...(canonicalUrl ? { url: canonicalUrl } : {}),
  ...(schemaImage ? { image: schemaImage } : {}),
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faq.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---
<!doctype html>
<html lang={langConfig.code}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#083B48" />
    <meta name="description" content={t.meta.description} />
    <title>{t.meta.title}</title>
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="alternate" hreflang={langConfig.code} href={canonicalUrl ?? alternatePath} />
    <link rel="alternate" hreflang={languages[otherLang].code} href={alternatePath.startsWith('http') ? alternatePath : (Astro.site ? new URL(alternatePath, Astro.site).toString() : alternatePath)} />
    <link rel="alternate" hreflang="x-default" href={Astro.site ? new URL('/', Astro.site).toString() : '/'} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.ogDescription} />
    <meta property="og:image" content={ogImage} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:locale" content={langConfig.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <script type="application/ld+json" set:html={JSON.stringify(attractionLd)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)}></script>

    <script is:inline define:vars={{ storageKey: `cloud9-siargao-itinerary-v1-${lang}` }}>
      window.__STORAGE_KEY__ = storageKey;
    </script>
  </head>
  <body>
    <header class="absolute inset-x-0 top-0 z-30 border-b border-white/15 bg-[#083b48]/35 text-white backdrop-blur-md">
      <div class="shell flex min-h-20 items-center justify-between gap-6">
        <a href={`${prefix}/#top`} class="shrink-0" aria-label={t.meta.title}>
          <img src="/logo.svg" alt={t.meta.title.split('—')[0].trim()} width="210" height="52" class="h-12 w-auto rounded-md bg-white/90 px-2 py-1" />
        </a>
        <nav aria-label="Main navigation" class="hidden items-center gap-6 text-sm font-bold md:flex">
          <a href={`${prefix}/#visit`} class="transition hover:text-[#ffd18b]">{t.nav.plan}</a>
          <a href={`${prefix}/#getting-there`} class="transition hover:text-[#ffd18b]">{t.nav.gettingThere}</a>
          <a href={`${prefix}/#nearby`} class="transition hover:text-[#ffd18b]">{t.nav.nearby}</a>
          <a href={`${prefix}/#trip-list`} class="transition hover:text-[#ffd18b]">{t.nav.tripList}</a>
          <a href={`${prefix}/#faq`} class="transition hover:text-[#ffd18b]">{t.nav.faq}</a>
          <a href={alternatePath} class="transition hover:text-[#7ee5d7]" hreflang={languages[otherLang].code}>{languages[otherLang].label}</a>
        </nav>
        <div class="flex items-center gap-2">
          <a
            href={alternatePath}
            class="rounded-full border border-white/35 bg-white/10 px-3 py-2 text-xs font-extrabold tracking-wide text-white transition hover:bg-white hover:text-[#083b48] md:hidden"
            hreflang={languages[otherLang].code}
          >
            {languages[otherLang].label}
          </a>
          <a
            href="https://maps.app.goo.gl/9QxXhm87kWjkYFy27"
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full border border-white/35 bg-white/10 px-4 py-2 text-xs font-extrabold tracking-wide text-white transition hover:bg-white hover:text-[#083b48]"
            aria-label={t.nav.openMap}
          >
            {t.nav.openMap}
          </a>
        </div>
      </div>
    </header>

    <main id="top">
      <section class="relative isolate min-h-[800px] overflow-hidden bg-[#083b48] text-white">
        <img
          src="/images/cloud9-hero.jpg"
          alt={t.hero.sub}
          width="1280"
          height="854"
          fetchpriority="high"
          class="absolute inset-0 h-full w-full object-cover object-center"
        />
        <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(5,40,49,.90)_0%,rgba(5,40,49,.62)_48%,rgba(5,40,49,.18)_78%),linear-gradient(0deg,rgba(5,40,49,.72)_0%,transparent_50%)]"></div>
        <div class="absolute -right-40 top-28 h-[520px] w-[520px] rounded-full border border-white/20"></div>
        <div class="absolute -right-24 top-44 h-[360px] w-[360px] rounded-full border border-white/20"></div>
        <div class="shell relative flex min-h-[800px] items-end pb-16 pt-36 md:pb-24">
          <div class="max-w-4xl">
            <p class="eyebrow mb-7 text-[#ffd18b]">{t.hero.eyebrow}</p>
            <h1 class="max-w-4xl text-[clamp(4.1rem,11vw,9.4rem)] font-black leading-[.76] tracking-[-.075em]">
              {t.hero.titleLine1}<br /><span class="text-[#7ee5d7]">{t.hero.titleLine2}</span>
            </h1>
            <p class="mt-8 max-w-2xl text-lg leading-8 text-white/88 md:text-xl">
              {t.hero.sub}
            </p>
            <div class="mt-10 flex flex-wrap gap-3">
              <a href={`${prefix}/#visit`} class="rounded-full bg-[#f5a24b] px-6 py-3 text-sm font-black text-[#083b48] transition hover:-translate-y-0.5 hover:bg-[#ffd18b]">{t.hero.ctaPlan}</a>
              <a href={`${prefix}/#the-break`} class="rounded-full border border-white/45 bg-white/10 px-6 py-3 text-sm font-black text-white backdrop-blur transition hover:bg-white/20">{t.hero.ctaReef}</a>
            </div>
          </div>
        </div>
      </section>

      <section aria-label="Quick facts" class="relative z-10 -mt-1 bg-[#083b48] text-white">
        <div class="shell grid grid-cols-2 border-x border-white/10 md:grid-cols-4">
          <div class="border-b border-r border-white/10 p-5 md:border-b-0 md:p-7">
            <p class="text-3xl font-black text-[#7ee5d7]">4.5 / 5</p>
            <p class="mt-1 text-xs font-bold uppercase tracking-[.15em] text-white/60">{t.quickFacts.rating}</p>
          </div>
          <div class="border-b border-white/10 p-5 md:border-b-0 md:border-r md:p-7">
            <p class="text-3xl font-black text-[#ffd18b]">24 hours</p>
            <p class="mt-1 text-xs font-bold uppercase tracking-[.15em] text-white/60">{t.quickFacts.hours}</p>
          </div>
          <div class="border-r border-white/10 p-5 md:p-7">
            <p class="text-3xl font-black text-[#7ee5d7]">Sep–Nov</p>
            <p class="mt-1 text-xs font-bold uppercase tracking-[.15em] text-white/60">{t.quickFacts.season}</p>
          </div>
          <div class="p-5 md:p-7">
            <p class="text-3xl font-black text-[#ffd18b]">≈ 2 hours</p>
            <p class="mt-1 text-xs font-bold uppercase tracking-[.15em] text-white/60">{t.quickFacts.baseline}</p>
          </div>
        </div>
      </section>

      <div class="wave-rule my-10"></div>

      <section id="the-break" class="shell scroll-mt-24 py-16 md:py-24">
        <div class="grid items-start gap-10 lg:grid-cols-[1.04fr_.96fr] lg:gap-16">
          <div>
            <p class="eyebrow text-[#0a6e86]">{t.theBreak.eyebrow}</p>
            <h2 class="section-title mt-5 max-w-3xl text-[#083b48]" set:html={t.theBreak.title.replace('\n', '<br />')}></h2>
            <p class="mt-7 max-w-2xl text-lg leading-8 text-[#38565e]">
              {t.theBreak.desc}
            </p>

            <div class="mt-10 grid gap-4 sm:grid-cols-3">
              <div class="rounded-[1.6rem] bg-[#083b48] p-5 text-white">
                <span class="text-2xl">↗</span>
                <h3 class="mt-8 font-black">{t.theBreak.card1Title}</h3>
                <p class="mt-2 text-sm leading-6 text-white/70">{t.theBreak.card1Desc}</p>
              </div>
              <div class="rounded-[1.6rem] bg-[#f3e7cf] p-5">
                <span class="text-2xl">◌</span>
                <h3 class="mt-8 font-black">{t.theBreak.card2Title}</h3>
                <p class="mt-2 text-sm leading-6 text-[#4f5d5b]">{t.theBreak.card2Desc}</p>
              </div>
              <div class="rounded-[1.6rem] bg-[#d8f5ec] p-5">
                <span class="text-2xl">〰</span>
                <h3 class="mt-8 font-black">{t.theBreak.card3Title}</h3>
                <p class="mt-2 text-sm leading-6 text-[#365c5a]">{t.theBreak.card3Desc}</p>
              </div>
            </div>
          </div>

          <figure class="relative lg:mt-20">
            <div class="absolute -left-5 -top-5 -z-10 h-full w-full rounded-[2rem] border-2 border-[#0a6e86]/20"></div>
            <img
              src="/images/cloud9-boardwalk.jpg"
              alt={t.theBreak.caption}
              width="1280"
              height="853"
              loading="lazy"
              class="aspect-[4/5] w-full rounded-[2rem] object-cover"
            />
            <figcaption class="mt-3 text-xs font-semibold text-[#587078]">{t.theBreak.caption}</figcaption>
          </figure>
        </div>
      </section>

      <section id="visit" class="scroll-mt-24 bg-[#f3e7cf] py-20 md:py-28">
        <div class="shell">
          <div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:gap-14">
            <div>
              <p class="eyebrow text-[#9f513e]">{t.visit.eyebrow}</p>
              <h2 class="section-title mt-5 text-[#083b48]">{t.visit.title}</h2>
              <p class="mt-6 max-w-lg leading-7 text-[#56625f]">{t.visit.sub}</p>
            </div>

            <div class="grid gap-4 md:grid-cols-2">
              <article class="rounded-[1.8rem] bg-[#083b48] p-7 text-white md:row-span-2">
                <p class="text-xs font-black uppercase tracking-[.18em] text-[#7ee5d7]">{t.visit.feeTitle}</p>
                <h3 class="mt-4 text-3xl font-black">{t.visit.feeHeader}</h3>
                <p class="mt-4 leading-7 text-white/75">{t.visit.feeDesc}</p>
                <div class="mt-8 border-t border-white/15 pt-5 text-sm text-white/65">{t.visit.feeNote}</div>
              </article>

              <article class="rounded-[1.8rem] bg-white/75 p-7">
                <p class="text-xs font-black uppercase tracking-[.18em] text-[#0a6e86]">Parking</p>
                <h3 class="mt-3 text-2xl font-black text-[#083b48]">{t.visit.parkingHeader}</h3>
                <p class="mt-3 leading-7 text-[#56625f]">{t.visit.parkingDesc}</p>
              </article>

              <article class="rounded-[1.8rem] bg-[#ffd9aa] p-7">
                <p class="text-xs font-black uppercase tracking-[.18em] text-[#8c4b2f]">{lang === 'en' ? 'Best time & stay' : 'Pinakamagandang oras at pananatili'}</p>
                <h3 class="mt-3 text-2xl font-black text-[#083b48]">{t.visit.timeHeader}</h3>
                <p class="mt-3 leading-7 text-[#5d5548]">{t.visit.timeDesc}</p>
              </article>

              <article class="rounded-[1.8rem] bg-[#d8f5ec] p-7 md:col-span-2">
                <p class="text-xs font-black uppercase tracking-[.18em] text-[#0a6e86]">{t.visit.bringHeader}</p>
                <div class="mt-4 flex flex-wrap gap-2">
                  {t.visit.bringTags.map((item) => (
                    <span class="rounded-full border border-[#0a6e86]/20 bg-white/65 px-4 py-2 text-sm font-bold text-[#23525b]">{item}</span>
                  ))}
                </div>
              </article>
            </div>
          </div>
        </div>
      </section>

      <section id="getting-there" class="shell scroll-mt-24 py-20 md:py-28">
        <div class="grid gap-12 lg:grid-cols-2">
          <div>
            <p class="eyebrow text-[#0a6e86]">{t.gettingThere.eyebrow}</p>
            <h2 class="section-title mt-5 text-[#083b48]">{t.gettingThere.title}</h2>
            <div class="mt-10 space-y-0 border-l-2 border-[#0a6e86]/20">
              <article class="relative pb-10 pl-8">
                <span class="absolute -left-[9px] top-1 h-4 w-4 rounded-full bg-[#0a6e86] ring-4 ring-[#edf9f5]"></span>
                <h3 class="text-xl font-black">{t.gettingThere.step1Title}</h3>
                <p class="mt-2 leading-7 text-[#557078]">{t.gettingThere.step1Desc}</p>
              </article>
              <article class="relative pb-10 pl-8">
                <span class="absolute -left-[9px] top-1 h-4 w-4 rounded-full bg-[#19a7a0] ring-4 ring-[#edf9f5]"></span>
                <h3 class="text-xl font-black">{t.gettingThere.step2Title}</h3>
                <p class="mt-2 leading-7 text-[#557078]">{t.gettingThere.step2Desc}</p>
              </article>
              <article class="relative pb-10 pl-8">
                <span class="absolute -left-[9px] top-1 h-4 w-4 rounded-full bg-[#f5a24b] ring-4 ring-[#edf9f5]"></span>
                <h3 class="text-xl font-black">{t.gettingThere.step3Title}</h3>
                <p class="mt-2 leading-7 text-[#557078]">{t.gettingThere.step3Desc}</p>
              </article>
              <article class="relative pl-8">
                <span class="absolute -left-[9px] top-1 h-4 w-4 rounded-full bg-[#e56d55] ring-4 ring-[#edf9f5]"></span>
                <h3 class="text-xl font-black">{t.gettingThere.step4Title}</h3>
                <p class="mt-2 leading-7 text-[#557078]">{t.gettingThere.step4Desc}</p>
              </article>
            </div>
          </div>

          <div class="overflow-hidden rounded-[2rem] border border-[#083b48]/10 bg-white shadow-[0_28px_70px_rgba(8,59,72,.12)]">
            <iframe
              class="map-frame h-[600px] w-full border-0"
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d15725.737496047737!2d126.15567562837411!3d9.813836414111607!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x330409ed5e3da33d%3A0xd2bbc5516a66d5cb!2sCloud%209%20Surfing%20Area!5e0!3m2!1szh-CN!2s!4v1786366809117!5m2!1szh-CN!2s"
              title={t.gettingThere.mapTitle}
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            ></iframe>
          </div>
        </div>
      </section>

      <section id="nearby" class="scroll-mt-24 bg-[#083b48] py-20 text-white md:py-28">
        <div class="shell">
          <div class="grid gap-8 lg:grid-cols-[.82fr_1.18fr] lg:items-end">
            <div>
              <p class="eyebrow text-[#7ee5d7]">{t.nearby.eyebrow}</p>
              <h2 class="section-title mt-5" set:html={t.nearby.title.replace('\n', '<br />')}></h2>
            </div>
            <p class="max-w-xl justify-self-end text-lg leading-8 text-white/68">{t.nearby.sub}</p>
          </div>

          <div class="mt-14 grid gap-5 lg:grid-cols-3">
            <article class="rounded-[1.8rem] border border-white/12 bg-white/7 p-7">
              <p class="text-xs font-black uppercase tracking-[.18em] text-[#ffd18b]">{t.nearby.foodLabel}</p>
              <h3 class="mt-5 text-2xl font-black">{t.nearby.foodLoka}</h3>
              <p class="mt-3 leading-7 text-white/68">{t.nearby.foodLokaDesc}</p>
            </article>
            <article class="rounded-[1.8rem] border border-white/12 bg-white/7 p-7">
              <p class="text-xs font-black uppercase tracking-[.18em] text-[#ffd18b]">{t.nearby.foodLabel}</p>
              <h3 class="mt-5 text-2xl font-black">{t.nearby.foodHawker}</h3>
              <p class="mt-3 leading-7 text-white/68">{t.nearby.foodHawkerDesc}</p>
            </article>
            <article class="rounded-[1.8rem] border border-white/12 bg-white/7 p-7">
              <p class="text-xs font-black uppercase tracking-[.18em] text-[#ffd18b]">{t.nearby.foodLabel}</p>
              <h3 class="mt-5 text-2xl font-black">{t.nearby.foodMasala}</h3>
              <p class="mt-3 leading-7 text-white/68">{t.nearby.foodMasalaDesc}</p>
            </article>
          </div>

          <div class="mt-16 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            <article class="overflow-hidden rounded-[1.9rem] bg-[#edf9f5] text-[#083b48]">
              <div class="h-56 overflow-hidden">
                <img src="/images/cloud9-boardwalk.jpg" alt={t.nearby.attJackingDesc} width="1280" height="853" loading="lazy" class="h-full w-full object-cover transition duration-500 hover:scale-105" />
              </div>
              <div class="p-7">
                <p class="text-xs font-black uppercase tracking-[.18em] text-[#0a6e86]">{t.nearby.attJackingLabel}</p>
                <h3 class="mt-3 text-3xl font-black">{t.nearby.attJacking}</h3>
                <p class="mt-3 leading-7 text-[#506b72]">{t.nearby.attJackingDesc}</p>
              </div>
            </article>
            <article class="overflow-hidden rounded-[1.9rem] bg-[#edf9f5] text-[#083b48]">
              <div class="h-56 overflow-hidden">
                <img src="/images/guyam-island.jpg" alt={t.nearby.attGuyamDesc} width="1280" height="853" loading="lazy" class="h-full w-full object-cover transition duration-500 hover:scale-105" />
              </div>
              <div class="p-7">
                <p class="text-xs font-black uppercase tracking-[.18em] text-[#0a6e86]">{t.nearby.attGuyamLabel}</p>
                <h3 class="mt-3 text-3xl font-black">{t.nearby.attGuyam}</h3>
                <p class="mt-3 leading-7 text-[#506b72]">{t.nearby.attGuyamDesc}</p>
              </div>
            </article>
            <article class="overflow-hidden rounded-[1.9rem] bg-[#edf9f5] text-[#083b48] md:col-span-2 lg:col-span-1">
              <div class="h-56 overflow-hidden">
                <img src="/images/magpupungko.jpg" alt={t.nearby.attMagpupungkoDesc} width="1280" height="853" loading="lazy" class="h-full w-full object-cover transition duration-500 hover:scale-105" />
              </div>
              <div class="p-7">
                <p class="text-xs font-black uppercase tracking-[.18em] text-[#0a6e86]">{t.nearby.attMagpupungkoLabel}</p>
                <h3 class="mt-3 text-3xl font-black">{t.nearby.attMagpupungko}</h3>
                <p class="mt-3 leading-7 text-[#506b72]">{t.nearby.attMagpupungkoDesc}</p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section id="trip-list" class="scroll-mt-24 bg-[#d8f5ec] py-20 md:py-28">
        <div class="shell grid gap-10 lg:grid-cols-[1fr_.8fr] lg:gap-16">
          <div>
            <p class="eyebrow text-[#0a6e86]">{t.tripList.eyebrow}</p>
            <h2 class="section-title mt-5 text-[#083b48]">{t.tripList.title}</h2>
            <p class="mt-6 max-w-2xl text-lg leading-8 text-[#49666b]">{t.tripList.sub}</p>

            <div class="mt-9 grid gap-3 sm:grid-cols-2">
              {itineraryItems.map((item) => (
                <button
                  type="button"
                  class="itinerary-add group rounded-[1.4rem] border border-[#0a6e86]/15 bg-white/70 p-5 text-left transition hover:-translate-y-0.5 hover:border-[#0a6e86]/35 hover:bg-white"
                  data-id={item.id}
                  data-name={item.name}
                  data-meta={item.meta}
                >
                  <span class="flex items-start justify-between gap-4">
                    <span>
                      <span class="block font-black text-[#083b48]">{item.name}</span>
                      <span class="mt-1 block text-xs font-semibold text-[#658086]">{item.meta}</span>
                    </span>
                    <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-[#083b48] text-lg font-black text-white transition group-hover:bg-[#0a6e86]">+</span>
                  </span>
                </button>
              ))}
            </div>
          </div>

          <aside class="card self-start rounded-[2rem] p-6 md:p-8" aria-labelledby="saved-title">
            <div class="flex items-center justify-between gap-4">
              <div>
                <p class="text-xs font-black uppercase tracking-[.18em] text-[#0a6e86]">{t.tripList.savedHeader}</p>
                <h3 id="saved-title" class="mt-2 text-2xl font-black text-[#083b48]">{t.tripList.savedTitle}</h3>
              </div>
              <button id="clear-itinerary" type="button" class="rounded-full border border-[#083b48]/15 px-3 py-2 text-xs font-extrabold text-[#49666b] transition hover:bg-[#083b48] hover:text-white">{t.tripList.clear}</button>
            </div>
            <div id="itinerary-live" class="sr-only" aria-live="polite"></div>
            <ul id="saved-itinerary" class="mt-6 space-y-3"></ul>
            <p id="empty-itinerary" class="mt-6 rounded-[1.2rem] bg-[#edf9f5] p-5 text-sm leading-6 text-[#60777b]">{t.tripList.empty}</p>
          </aside>
        </div>
      </section>

      <section id="faq" class="shell scroll-mt-24 py-20 md:py-28">
        <div class="grid gap-12 lg:grid-cols-[.7fr_1.3fr]">
          <div>
            <p class="eyebrow text-[#0a6e86]">{t.faq.eyebrow}</p>
            <h2 class="section-title mt-5 text-[#083b48]">{t.faq.title}</h2>
            <p class="mt-6 leading-7 text-[#587078]">{t.faq.sub}</p>
          </div>
          <div class="divide-y divide-[#083b48]/12 border-y border-[#083b48]/12">
            {t.faq.items.map((item) => (
              <details class="group py-2">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-lg font-black text-[#083b48] marker:content-none">
                  {item.q}
                  <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-[#083b48] text-white transition group-open:rotate-45">+</span>
                </summary>
                <p class="max-w-3xl pb-6 pr-12 leading-7 text-[#587078]">{item.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="bg-[#f5a24b] py-10">
        <div class="shell flex flex-col justify-between gap-6 md:flex-row md:items-center">
          <div>
            <p class="text-xs font-black uppercase tracking-[.18em] text-[#6d3e28]">{t.reefRule.eyebrow}</p>
            <p class="mt-2 text-2xl font-black text-[#083b48]">{t.reefRule.body}</p>
          </div>
          <a href={`${prefix}/#top`} class="self-start rounded-full bg-[#083b48] px-5 py-3 text-xs font-black text-white md:self-auto">{t.reefRule.toTop}</a>
        </div>
      </section>
    </main>

    <footer class="bg-[#052c35] py-12 text-white">
      <div class="shell grid gap-8 lg:grid-cols-[.75fr_1.25fr]">
        <div>
          <img src="/logo.svg" alt={t.meta.title.split('—')[0].trim()} width="210" height="52" class="h-12 w-auto rounded-md bg-white/90 px-2 py-1" />
          <p class="mt-5 max-w-md text-sm leading-6 text-white/58">{t.footer.disclaimer}</p>
        </div>
        <div class="grid gap-7 sm:grid-cols-2">
          <div>
            <h2 class="text-xs font-black uppercase tracking-[.18em] text-[#7ee5d7]">{t.footer.sourcesLabel}</h2>
            <p class="mt-3 text-sm leading-6 text-white/58">{t.footer.sourcesBody}</p>
          </div>
          <div>
            <h2 class="text-xs font-black uppercase tracking-[.18em] text-[#7ee5d7]">{t.footer.creditsLabel}</h2>
            <p class="mt-3 text-xs leading-6 text-white/55">
              {t.footer.creditsBody}
            </p>
          </div>
        </div>
      </div>
    </footer>

    <script is:inline define:vars={{ copy: { remove: t.tripList.remove, added: t.tripList.added, removed: t.tripList.removed, cleared: t.tripList.cleared } }}>
      (function () {
        type SavedItem = { id: string; name: string; meta: string };
        const storageKey = window.__STORAGE_KEY__ || 'cloud9-siargao-itinerary-v1';
        const list = document.querySelector<HTMLUListElement>('#saved-itinerary');
        const empty = document.querySelector<HTMLElement>('#empty-itinerary');
        const live = document.querySelector<HTMLElement>('#itinerary-live');
        const clearButton = document.querySelector<HTMLButtonElement>('#clear-itinerary');
        const addButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.itinerary-add'));

        const readSaved = (): SavedItem[] => {
          try {
            const parsed = JSON.parse(localStorage.getItem(storageKey) ?? '[]');
            return Array.isArray(parsed) ? parsed : [];
          } catch {
            return [];
          }
        };

        const writeSaved = (items: SavedItem[]) => {
          localStorage.setItem(storageKey, JSON.stringify(items));
        };

        const render = () => {
          if (!list || !empty) return;
          const saved = readSaved();
          list.innerHTML = '';
          empty.hidden = saved.length > 0;

          saved.forEach((item) => {
            const li = document.createElement('li');
            li.className = 'flex items-start justify-between gap-4 rounded-[1.1rem] border border-[#083b48]/10 bg-white p-4';

            const copy = document.createElement('div');
            const title = document.createElement('p');
            title.className = 'font-black text-[#083b48]';
            title.textContent = item.name;
            const meta = document.createElement('p');
            meta.className = 'mt-1 text-xs font-semibold text-[#71868a]';
            meta.textContent = item.meta;
            copy.append(title, meta);

            const remove = document.createElement('button');
            remove.type = 'button';
            remove.className = 'shrink-0 rounded-full border border-[#083b48]/15 px-3 py-1.5 text-xs font-extrabold text-[#49666b] hover:bg-[#083b48] hover:text-white';
            remove.textContent = copy_?.remove ?? 'Remove';
            remove.setAttribute('aria-label', `Remove ${item.name} from itinerary`);
            remove.addEventListener('click', () => {
              writeSaved(readSaved().filter((savedItem) => savedItem.id !== item.id));
              if (live) live.textContent = (copy_?.removed ?? ((n: string) => `${n} removed.`))(item.name);
              render();
            });

            li.append(copy, remove);
            list.append(li);
          });

          addButtons.forEach((button) => {
            const isSaved = saved.some((item) => item.id === button.dataset.id);
            button.disabled = isSaved;
            button.classList.toggle('opacity-55', isSaved);
            const badge = button.querySelector<HTMLElement>('span > span:last-child');
            if (badge) badge.textContent = isSaved ? '✓' : '+';
          });
        };

        addButtons.forEach((button) => {
          button.addEventListener('click', () => {
            const item: SavedItem = {
              id: button.dataset.id ?? '',
              name: button.dataset.name ?? '',
              meta: button.dataset.meta ?? '',
            };
            if (!item.id) return;
            const saved = readSaved();
            if (!saved.some((savedItem) => savedItem.id === item.id)) {
              writeSaved([...saved, item]);
              if (live) live.textContent = (copy_?.added ?? ((n: string) => `${n} added.`))(item.name);
              render();
            }
          });
        });

        clearButton?.addEventListener('click', () => {
          localStorage.removeItem(storageKey);
          if (live) live.textContent = copy_?.cleared ?? 'Itinerary cleared.';
          render();
        });

        render();
      })();
    </script>
  </body>
</html>
